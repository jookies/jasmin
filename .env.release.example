# Environment for docker-compose.release.yml — the stack that runs PUBLISHED
# images (no source checkout, no local build). Copy to .env next to the compose
# file and fill in every REQUIRED value before starting.
#
#   cp .env.release.example .env
#
# .env is git-ignored — never commit it.
#
# Generating strong values:
#   Linux / macOS:  openssl rand -hex 24
#   Windows (PowerShell):
#     -join ((1..24) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })

# ============================================================================
# Image
# ============================================================================
# Pinned on purpose. "latest" moves under you on the next release; pin the
# version you tested and bump it deliberately.
SYNEVYR_VERSION=0.1.0
SYNEVYR_IMAGE=aroksetx/synevyr-messaging-platform

# ============================================================================
# Postgres — durable store for submit transactions, CDRs/billing, the message
# spool and the HA advisory lock. This volume is what you back up
# (deploy/BACKUP.md). Internal to the compose network; never published.
# ============================================================================
POSTGRES_USER=synevyr
# REQUIRED
POSTGRES_PASSWORD=
POSTGRES_DB=synevyr

# ============================================================================
# RabbitMQ — submit/deliver queueing between the front doors and the connector
# workers. Losing it loses in-flight messages, not historical CDRs.
# ============================================================================
RABBITMQ_DEFAULT_USER=jasmin
# REQUIRED
RABBITMQ_DEFAULT_PASS=

# ============================================================================
# Redis — DLR tracking, quota cache, multipart reassembly and the termination
# activation window. Not the durability boundary (Postgres is). No auth by
# default: it is never published to the host, only reachable on the compose
# network.
# ============================================================================
REDIS_URL=redis://redis:6379/0

# ============================================================================
# Gateway secrets. Each resolves an "env:NAME" reference inside the config
# (internal/app/gateway/secrets.go). All REQUIRED — the gateway refuses to
# start when one does not resolve, rather than starting with a blank password.
# ============================================================================
# Bearer token for the admin HTTP API (loopback-only port 8405).
ADMIN_TOKEN=
# Admin web UI login (http://127.0.0.1:8404, loopback-only). Username is
# "admin", set in the config's admin.web_username.
ADMIN_WEB_PASSWORD=
# jCli management console login (loopback-only). Username is "jcliadmin".
JCLI_PASSWORD=
# SMSC connector bind password. The shipped config points at the bundled
# bootstrap-smsc simulator, which accepts any password — so this default works
# out of the box. Change it, and the connector's host/port/system_id, when you
# point at a real SMSC.
SMSC_PASSWORD=bootstrap-smsc-accepts-any-password
# Password for the default inbound SMPPS account (the SMPP server on 2775).
# REQUIRED.
#
# GOTCHA: SMPP 3.4 caps the bind password at 8 characters (a COctetString of 9
# octets including the null terminator). A longer value cannot be encoded by a
# conformant ESME, so the bind fails before authentication is even attempted.
# Generate exactly 8 hex characters:
#   Linux / macOS:  openssl rand -hex 4
# 8 hex characters is weak on its own — keep the SMPP listener reachable only
# by known peers.
SMPPS_USER_PASSWORD=

# ============================================================================
# Host port bindings. The HTTP API, REST daemon and SMPP server are published
# on all interfaces by design — they are the public data plane; put a reverse
# proxy with TLS in front of anything internet-facing. The admin web UI, admin
# REST API and jCli are hardcoded to 127.0.0.1 in docker-compose.release.yml
# regardless of these values; only the port number is configurable there.
# ============================================================================
GATEWAY_HTTP_PORT=1401
GATEWAY_REST_PORT=8080
GATEWAY_SMPP_PORT=2775
GATEWAY_ADMIN_API_PORT=8405
GATEWAY_ADMIN_WEB_PORT=8404
GATEWAY_JCLI_PORT=8990

# ============================================================================
# Gateway resource limits. Conservative starting points for a small single-node
# box; watch `docker stats` and adjust for your traffic.
# ============================================================================
GATEWAY_CPU_LIMIT=2.0
GATEWAY_MEM_LIMIT=1g
GATEWAY_CPU_RESERVATION=0.5
GATEWAY_MEM_RESERVATION=256m
