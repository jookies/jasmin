# Copy this file to .env and fill in every REQUIRED value before starting
# docker-compose.prod.yml. scripts/deploy/setup.sh does this for you and
# generates strong random values for anything left blank.
#
#   cp .env.example .env
#
# .env is already git-ignored — never commit it.

# ============================================================================
# Postgres — the durable store for submit transactions, CDRs/billing, and the
# HA advisory lock. Back this volume up (see deploy/BACKUP.md).
# ============================================================================
POSTGRES_USER=jasmin
# REQUIRED. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=jasmin

# ============================================================================
# RabbitMQ — submit/deliver queueing between the HTTP/SMPP front doors and the
# connector workers. Losing this data loses in-flight (not yet delivered to
# the SMSC) messages, not historical CDRs.
# ============================================================================
RABBITMQ_DEFAULT_USER=jasmin
# REQUIRED. Generate with: openssl rand -hex 24
RABBITMQ_DEFAULT_PASS=

# ============================================================================
# Redis — DLR-tracking / quota cache, not the durability boundary (Postgres
# is). No auth by default: it is never published to the host, only reachable
# on the compose-internal network. Leave as-is unless your threat model wants
# defense in depth (see the redis service comment in docker-compose.prod.yml).
# ============================================================================
REDIS_URL=redis://redis:6379/0

# ============================================================================
# Gateway secrets — each resolves an "env:NAME" reference inside
# configs/gateway.json (internal/app/gateway/secrets.go). All REQUIRED.
# ============================================================================
# Bearer token for the admin HTTP API.
ADMIN_TOKEN=
# Admin web UI (https://<host>:8404, loopback-only by default) login password.
# Username is "admin" (set in configs/gateway.json admin.web_username).
ADMIN_WEB_PASSWORD=
# jCli management console (loopback-only by default) login password.
# Username is "jcliadmin" (set in configs/gateway.json admin.jcli_username).
JCLI_PASSWORD=
# SMSC connector bind password. REQUIRED (the gateway's role hard-requires at
# least one connector, so this must always resolve). The shipped
# configs/gateway.json connector points at the bundled bootstrap-smsc
# simulator, which accepts any password — this default works out of the box.
# Change it (and the connector's host/port/system_id in configs/gateway.json)
# to your real SMSC's details when you have one — see
# configs/gateway.production.md.
SMSC_PASSWORD=bootstrap-smsc-accepts-any-password
# Password for the default inbound SMPPS account (configs/gateway.json
# smpps.users[0]). REQUIRED — the SMPP server (port 2775) is public by
# NOTE: SMPP 3.4 limits the bind password to 8 characters (a COctetString of
# 9 octets including the null terminator). A longer value cannot be encoded by a
# conformant ESME, so the bind fails before authentication. setup.sh generates 8
# hex characters here for that reason -- which is weak on its own, so keep the
# SMPP listener reachable only by known peers.
SMPPS_USER_PASSWORD=
# (--profile pb). See docs/pb-facade.md before turning this on.

# ============================================================================
# Host port bindings. HTTP API / REST daemon / SMPP server are published on
# all interfaces by design (they are the gateway's public data plane) — put a
# reverse proxy + TLS in front for anything internet-facing. Admin web UI and
# jCli are hardcoded to bind 127.0.0.1 in docker-compose.prod.yml regardless
# of these values; only the port number is configurable for those two.
# ============================================================================
GATEWAY_HTTP_PORT=1401
GATEWAY_REST_PORT=8080
GATEWAY_SMPP_PORT=2775
# Admin REST API (/admin/) -- loopback only; creates users and starts connectors.
GATEWAY_ADMIN_API_PORT=8405
GATEWAY_ADMIN_WEB_PORT=8404
GATEWAY_JCLI_PORT=8990
PB_INTERCEPTOR_PORT=8987
PB_ROUTER_PORT=8988
PB_CLIENT_PORT=8989
PB_SMPPS_PORT=14000

# ============================================================================
# Image tag. Local builds default to "latest"; set this if you tag/push to a
# registry as part of your own release process (out of scope here — this repo
# builds locally via the `build:` key in docker-compose.prod.yml).
# ============================================================================
GATEWAY_IMAGE=jasmin-gateway
PBFACADE_IMAGE=jasmin-pb-facade
BOOTSTRAP_SMSC_IMAGE=jasmin-bootstrap-smsc
GATEWAY_IMAGE_TAG=latest

# ============================================================================
# Resource limits (docker compose `deploy.resources`). Defaults are
# conservative starting points for a small single-node box; watch actual
# usage (docker stats) and raise/lower per your traffic and instance size.
# ============================================================================
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPU_RESERVATION=0.25
POSTGRES_MEM_RESERVATION=256m

RABBITMQ_CPU_LIMIT=1.0
RABBITMQ_MEM_LIMIT=512m
RABBITMQ_CPU_RESERVATION=0.25
RABBITMQ_MEM_RESERVATION=128m

REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=256m
REDIS_CPU_RESERVATION=0.1
REDIS_MEM_RESERVATION=64m

GATEWAY_CPU_LIMIT=2.0
GATEWAY_MEM_LIMIT=1g
GATEWAY_CPU_RESERVATION=0.5
GATEWAY_MEM_RESERVATION=256m
