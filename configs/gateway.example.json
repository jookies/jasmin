{
  "role": "http+smppc",
  "pickle_codec": "native",
  "amqp_durable_topology": true,
  "ha": {
    "namespace": "gateway-example",
    "standby_retry_seconds": 1,
    "standby_listen_address": "0.0.0.0:1401"
  },
  "rest_api": {
    "listen_address": "0.0.0.0:8080",
    "http_throughput_per_worker": 8,
    "smart_qos": true,
    "max_pending_tasks": 10000,
    "max_attempts": 3,
    "retry_delay_seconds": 1,
    "callback_max_attempts": 5,
    "callback_retry_delay_seconds": 1
  },
  "outbound": {
    "listen_address": "0.0.0.0:1401",
    "amqp_url": "amqp://guest:guest@rabbitmq:5672/",
    "postgres_dsn": "postgres://jasmin:jasmin@postgres:5432/jasmin?sslmode=disable",
    "python_path": "python3",
    "cdr_currency": "XXX",
    "cdr_retention_days": 0,
    "cdr_retention_batch_size": 1000,
    "cdr_maintenance_interval_seconds": 86400,
    "users": [
      {
        "username": "smppuser",
        "external_id": "smppuser",
        "password_sha256": "5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8",
        "balance": 100.0,
        "submit_sm_count": 10000,
        "mt_credential": {
          "http_bulk": true
        }
      }
    ],
    "mt_interceptors": [
      {
        "order": 10,
        "filters": [
          {
            "type": "short_message",
            "pattern": ".*STOP"
          }
        ],
        "py_code": "smpp_status = 88\nhttp_status = 400"
      }
    ],
    "mo_interceptors": [
      {
        "order": 10,
        "filters": [
          {
            "type": "short_message",
            "pattern": ".*STOP"
          }
        ],
        "py_code": "smpp_status = 255"
      }
    ],
    "routes": [
      {
        "connector_id": "smsc-primary",
        "rate": 0.0,
        "default": true,
        "order": 0
      }
    ]
  },
  "connectors": [
    {
      "cid": "smsc-primary",
      "host": "smppsim",
      "port": 2775,
      "system_id": "smppclient1",
      "password": "password",
      "system_type": "",
      "bind": "transceiver",
      "addr_ton": 0,
      "addr_npi": 0,
      "address_range": "",
      "src_ton": 2,
      "src_npi": 1,
      "dst_ton": 1,
      "dst_npi": 1,
      "service_type": "",
      "protocol_id": 0,
      "replace_if_present_flag": 0,
      "sm_default_msg_id": 0,
      "source_addr": "",
      "trx_to": 30,
      "res_to": 60,
      "pdu_to": 30,
      "con_loss_retry": true,
      "con_fail_retry": true,
      "con_loss_delay": 10,
      "con_fail_delay": 10,
      "tls_enabled": false,
      "priority": 0,
      "log_level": "INFO",
      "submit_sm_throughput": 1.0,
      "prefetch_count": 1
    }
  ],
  "required_connector_ids": [
    "smsc-primary"
  ],
  "bind_timeout_seconds": 30,
  "dlr_lookup": {
    "amqp_url": "",
    "redis_url": "redis://redis:6379/0",
    "pid": "main"
  },
  "dlr_thrower": {
    "amqp_url": ""
  },
  "deliver_sm_thrower": {
    "amqp_url": ""
  },
  "mo_routes": [
    {
      "order": 10,
      "filter_connector_id": "smsc-primary",
      "filters": [
        {
          "type": "destination_addr",
          "pattern": "^2255"
        }
      ],
      "connector": {
        "type": "smpps",
        "system_id": "shortcode-app"
      }
    },
    {
      "order": 0,
      "default": true,
      "connector": {
        "type": "http",
        "cid": "mo-sink",
        "url": "http://host.docker.internal:8899/mo",
        "method": "GET"
      }
    }
  ],
  "submit_audit_log": {
    "level": "INFO",
    "privacy": false
  },
  "admin": {
    "db_path": "/var/lib/jasmin/admin.db",
    "token": "env:ADMIN_TOKEN",
    "web_listen_address": "0.0.0.0:8404",
    "web_username": "admin",
    "web_password": "env:ADMIN_WEB_PASSWORD",
    "allow_interceptor_editing": true,
    "jcli_listen_address": "0.0.0.0:8990",
    "jcli_username": "jcliadmin",
    "jcli_password": "env:JCLI_PASSWORD",
    "jcli_idle_timeout": 300,
    "api_listen_address": "0.0.0.0:8405"
  },
  "smpps": {
    "bind_addr": "0.0.0.0:2775",
    "enquire_link_timeout": 30,
    "users": [
      {
        "system_id": "shortcode-app",
        "password": "shortcodepw"
      }
    ]
  }
}
