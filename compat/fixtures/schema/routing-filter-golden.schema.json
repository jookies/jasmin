{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpitspace.github.io/jasmin-go/schemas/routing-filter-golden.schema.json",
  "title": "Jasmin deterministic routing filter golden fixture",
  "$defs": {
    "bytes": {
      "type": "object",
      "required": ["base64", "length", "sha256"],
      "properties": {
        "base64": {"type": "string"},
        "length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "nullableBytes": {
      "anyOf": [{"$ref": "#/$defs/bytes"}, {"type": "null"}]
    }
  },
  "type": "object",
  "required": ["schema_version", "baseline_commit", "source", "compatibility", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {"const": "jasmin/routing/Filters.py"},
    "compatibility": {
      "type": "object",
      "required": ["transparent", "connector", "user", "group", "source_addr", "destination_addr", "short_message", "date_interval", "time_interval", "tag"],
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"enum": ["mt", "mo"]}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "required": ["id", "source", "filter", "routable", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"const": "jasmin/routing/Filters.py"},
          "filter": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"enum": ["transparent", "connector", "user", "group", "source_addr", "destination_addr", "short_message", "date_interval", "time_interval", "tag"]},
              "connector_id": {"type": "string"},
              "user_id": {"type": "integer"},
              "group_id": {"type": "integer"},
              "pattern": {"type": "string"},
              "start": {"type": "string"},
              "end": {"type": "string"},
              "tag": {"type": ["string", "integer"]}
            },
            "additionalProperties": false
          },
          "routable": {
            "type": "object",
            "required": ["direction", "connector_id", "user_id", "group_id", "source_addr", "destination_addr", "short_message", "message_payload", "timestamp", "tags"],
            "properties": {
              "direction": {"enum": ["mt", "mo"]},
              "connector_id": {"type": "string"},
              "user_id": {"type": "integer"},
              "group_id": {"type": "integer"},
              "source_addr": {"$ref": "#/$defs/nullableBytes"},
              "destination_addr": {"$ref": "#/$defs/nullableBytes"},
              "short_message": {"$ref": "#/$defs/nullableBytes"},
              "message_payload": {"$ref": "#/$defs/nullableBytes"},
              "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"},
              "tags": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "expected": {
            "type": "object",
            "required": ["matched", "error_type"],
            "properties": {
              "matched": {"type": ["boolean", "null"]},
              "error_type": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
