{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpitspace.github.io/synevyr-go/schemas/segmentation-golden.schema.json",
  "title": "Jasmin payload segmentation golden fixture",
  "$defs": {
    "bytes": {
      "type": "object",
      "required": ["base64", "hex", "length", "sha256"],
      "properties": {
        "base64": {"type": "string"},
        "hex": {"type": "string", "pattern": "^[0-9a-f]*$"},
        "length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "concatenation": {
      "type": "object",
      "required": ["reference", "total", "sequence"],
      "properties": {
        "reference": {"type": "integer", "minimum": 1, "maximum": 255},
        "total": {"type": "integer", "minimum": 2, "maximum": 255},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 255},
        "bytes": {"$ref": "#/$defs/bytes"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "baseline_commit", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "classification", "emitted_reference", "consumed_payload_bytes", "truncated", "parts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "input": {
            "type": "object",
            "required": ["data_coding", "split_method", "max_parts", "initial_reference", "payload"],
            "properties": {
              "data_coding": {"type": "integer", "minimum": 0, "maximum": 255},
              "split_method": {"enum": ["sar", "udh"]},
              "max_parts": {"type": "integer", "minimum": 1, "maximum": 255},
              "initial_reference": {"type": "integer", "minimum": 0, "maximum": 255},
              "payload": {"$ref": "#/$defs/bytes"}
            },
            "additionalProperties": false
          },
          "classification": {
            "type": "object",
            "required": ["bits", "single_limit", "multipart_payload_bytes"],
            "properties": {
              "bits": {"enum": [7, 8, 16]},
              "single_limit": {"enum": [70, 140, 160]},
              "multipart_payload_bytes": {"enum": [134, 153]}
            },
            "additionalProperties": false
          },
          "emitted_reference": {"type": ["integer", "null"], "minimum": 1, "maximum": 255},
          "consumed_payload_bytes": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"},
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 255,
            "items": {
              "type": "object",
              "required": ["sequence", "payload", "short_message", "sar", "udh"],
              "properties": {
                "sequence": {"type": "integer", "minimum": 1, "maximum": 255},
                "payload": {"$ref": "#/$defs/bytes"},
                "short_message": {"$ref": "#/$defs/bytes"},
                "sar": {"anyOf": [{"$ref": "#/$defs/concatenation"}, {"type": "null"}]},
                "udh": {"anyOf": [{"$ref": "#/$defs/concatenation"}, {"type": "null"}]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
