# Go gateway (http+smppc role). The pickle encode/decode runs on the native Go
# codec (internal/transport/gopickle + picklecompat.NativeCodec) — no Python
# subprocess on the submit/deliver hot path.
#
# Python remains only for the MO/MT interceptor runner
# (scripts/interceptor_runner.py), which is stdlib-only: it exchanges JSON with
# the Go path and neither unpickles nor imports smpp.pdu / jasmin. The legacy
# pickle bridge (scripts/pickle_bridge.py, smpp-pdu3, the jasmin/ source tree) is
# retired from the image. The bridge codec is still selectable via
# pickle_codec: "bridge" for local regression, but then the script and its
# dependencies must be supplied out of band (mounted / added to a derived image).
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.gateway -t jasmin-gateway .

FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/jasmin-go-httpapi ./cmd/jasmin-go-httpapi

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd -r jasmin && useradd -r -g jasmin -d /app -s /usr/sbin/nologin jasmin \
    && mkdir -p /var/log/jasmin /var/lib/jasmin /etc/jasmin \
    && chown jasmin:jasmin /var/log/jasmin /var/lib/jasmin

WORKDIR /app
COPY scripts/interceptor_runner.py /app/scripts/interceptor_runner.py
COPY configs/gateway.example.json /etc/jasmin/gateway.json
COPY --from=build /out/jasmin-go-httpapi /usr/local/bin/jasmin-go-httpapi

USER jasmin
EXPOSE 1401

ENTRYPOINT ["/usr/local/bin/jasmin-go-httpapi"]
CMD ["--config", "/etc/jasmin/gateway.json"]
