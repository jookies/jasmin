# Trusted Twisted PB/jelly translator for the Go gateway. This sidecar is the
# only network process allowed to deserialize frozen Python PB objects.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd -r jasmin && useradd -r -g jasmin -d /app -s /usr/sbin/nologin jasmin

WORKDIR /src
COPY pyproject.toml setup.py README.rst ./
COPY jasmin/ jasmin/
RUN pip install --no-cache-dir .

USER jasmin
EXPOSE 8987 8988 8989 14000

ENTRYPOINT ["python", "/src/jasmin/bin/pbfacaded.py"]
